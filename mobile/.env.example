# Base URL of the Feedants backend API.
#
# If you leave this UNSET, the app derives the host from the Expo dev server,
# which usually "just works" on a physical device on the same Wi-Fi.
#
# Local machine + web/simulator:
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
#
# Android emulator (host machine is 10.0.2.2):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api/v1
#
# Physical device on your LAN (replace with your computer's IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
