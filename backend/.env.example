# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=4000

# Local docker-compose mongo
MONGODB_URI=mongodb://localhost:27017/feedants
# Durable single-node replica set (docker compose --profile rs) - enables transactions:
# MONGODB_URI=mongodb://localhost:27018/feedants?replicaSet=rs0&directConnection=true
# Atlas example:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/feedants

JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Comma separated list of allowed origins, or * for all
CORS_ORIGIN=*
